default_platform(:ios)

platform :ios do
  desc "Push localized metadata (name, subtitle, keywords, description, promotional text) to App Store Connect"
  lane :sync_metadata do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_KEY_PATH"],
      duration: 1200
    )
    deliver(
      api_key: api_key,
      app_identifier: "com.gambit.meusgastos",
      platform: "ios",
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      submit_for_review: false,
      run_precheck_before_submit: false
    )
  end
end
