default_platform(:ios)

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
    issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
    key_filepath: ENV["APP_STORE_CONNECT_KEY_PATH"],
    duration: 1200
  )
end

platform :ios do
  desc "Push localized metadata for iOS"
  lane :sync_metadata do
    deliver(
      api_key: asc_api_key,
      app_identifier: "com.gambit.meusgastos",
      platform: "ios",
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      submit_for_review: false,
      run_precheck_before_submit: false
    )
  end
end

platform :mac do
  desc "Push localized metadata for macOS (universal app, same bundle id as iOS)"
  lane :sync_metadata do
    deliver(
      api_key: asc_api_key,
      app_identifier: "com.gambit.meusgastos",
      platform: "osx",
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      submit_for_review: false,
      run_precheck_before_submit: false
    )
  end
end
